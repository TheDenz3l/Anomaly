{
  "expo": {
    "name": "Anomaly",
    "slug": "anomaly",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "anomaly",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bmar.anomaly",
      "appleTeamId": "XDT233YHBK",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Anomaly connects to its server on your local network.",
        "NSLocationWhenInUseUsageDescription": "Anomaly uses your location to find theatres, places and weather near you.",
        "NSMicrophoneUsageDescription": "Anomaly uses the microphone for hold-to-talk voice input.",
        "NSSpeechRecognitionUsageDescription": "Anomaly transcribes your voice on device.",
        "NSPhotoLibraryUsageDescription": "Anomaly attaches photos you choose to your messages.",
        "NSCameraUsageDescription": "Anomaly attaches photos you take to your messages."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#000000"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-status-bar",
      "expo-image-picker",
      [
        "expo-media-library",
        {
          "photosPermission": "Anomaly attaches photos you choose to your messages.",
          "savePhotosPermission": "Anomaly saves images you create to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-image",
      "expo-secure-store",
      "expo-speech-recognition",
      "expo-web-browser",
      [
        "expo-share-intent",
        {
          "iosShareExtensionName": "Anomaly Share",
          "iosActivationRules": {
            "NSExtensionActivationSupportsText": true,
            "NSExtensionActivationSupportsWebURLWithMaxCount": 1,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 1,
            "NSExtensionActivationSupportsImageWithMaxCount": 6,
            "NSExtensionActivationSupportsFileWithMaxCount": 6
          },
          "androidIntentFilters": ["text/*", "image/*", "*/*"],
          "androidMultiIntentFilters": ["image/*", "*/*"]
        }
      ],
      "./plugins/withSceneLifecycle",
      ["./plugins/withShareExtensionName", { "folder": "AnomalyShare", "displayName": "Anomaly" }]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
